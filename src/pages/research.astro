---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Research & Publications | XU CHUYAN" description="Research publications and exhibitions in AI, games, and interactive art">
  <div class="page-header">
    <div class="container">
      <h1 class="page-title gradient-text fade-in-up" data-en="Research & Publications" data-cn="研究与发表">Research & Publications</h1>
      <p class="page-subtitle fade-in-up" style="animation-delay: 0.2s"
         data-en="Peer-reviewed publications, exhibitions, and teaching experience"
         data-cn="同行评审出版物、展览和教学经历">
        Peer-reviewed publications, exhibitions, and teaching experience
      </p>
    </div>
  </div>

  <!-- Publications Section -->
  <section class="publications-section">
    <div class="container">
      <div class="intro-text reveal">
        <p data-en="As Lead Technical Developer, I engineered systems and interactive frameworks for the following peer-reviewed works:"
           data-cn="作为主要技术开发者，我为以下经过同行评审的作品设计了系统和交互框架：">
          As Lead Technical Developer, I engineered systems and interactive frameworks for the following peer-reviewed works:
        </p>
      </div>

      <div class="publications-list">
        <!-- Publication 1 -->
        <article class="publication-card reveal">
          <div class="pub-badge">SIGGRAPH Asia 2023</div>
          <h3 class="pub-title" 
              data-en="AI Nüshu: An Exploration of Language Emergence in Sisterhood Through the Lens of Computational Linguistics"
              data-cn="AI 女书：通过计算语言学视角探索姐妹情谊中的语言涌现">
            AI Nüshu: An Exploration of Language Emergence in Sisterhood Through the Lens of Computational Linguistics
          </h3>
          <p class="pub-venue">SIGGRAPH Asia 2023 Art Papers</p>
          <p class="pub-authors">Yuqian Sun, Yuying Tang, Ze Gao, Zhijun Pan, <strong>Chuyan Xu</strong>, et al.</p>
          <div class="pub-contribution">
            <strong data-en="Technical Contribution:" data-cn="技术贡献：">Technical Contribution:</strong>
            <span data-en="Implemented the real-time generative linguistics engine in Unity; designed the visual communication logic between AI agents."
                  data-cn="在 Unity 中实现实时生成式语言引擎；设计 AI 代理之间的视觉通信逻辑。">
              Implemented the real-time generative linguistics engine in Unity; designed the visual communication logic between AI agents.
            </span>
          </div>
          <a href="https://doi.org/10.1145/3610591.3616427" class="pub-link" target="_blank" rel="noopener">
            <span>doi.org/10.1145/3610591.3616427</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </article>

        <!-- Publication 2 -->
        <article class="publication-card reveal">
          <div class="pub-badge award">🏆 Award</div>
          <h3 class="pub-title"
              data-en="Hyborg Agency: Fostering AI Agents through Community Conversations in a Digital Forest"
              data-cn="Hyborg Agency：通过数字森林中的社区对话培育 AI 代理">
            Hyborg Agency: Fostering AI Agents through Community Conversations in a Digital Forest
          </h3>
          <p class="pub-venue">Proc. ACM Comput. Graph. Interact. Tech. (2025)</p>
          <p class="pub-authors">Yuqian Sun, Chenhang Cheng, <strong>Chuyan Xu</strong>, Chang Hee Lee, Ali Asadipour</p>
          <div class="pub-contribution">
            <strong data-en="Technical Contribution:" data-cn="技术贡献：">Technical Contribution:</strong>
            <span data-en="Architected the dual-platform bridge (Discord/Unity) and the multi-agent persistence infrastructure in a shared 3D environment."
                  data-cn="架构双平台桥接（Discord/Unity）和共享 3D 环境中的多代理持久化基础设施。">
              Architected the dual-platform bridge (Discord/Unity) and the multi-agent persistence infrastructure in a shared 3D environment.
            </span>
          </div>
          <p class="pub-award">🏆 LUMEN PRIZE Student Award</p>
          <a href="https://doi.org/10.1145/3736778" class="pub-link" target="_blank" rel="noopener">
            <span>doi.org/10.1145/3736778</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </article>

        <!-- Publication 3 -->
        <article class="publication-card reveal">
          <div class="pub-badge">CHI 2025</div>
          <h3 class="pub-title"
              data-en='"I Like Your Story!": A Co-Creative Story-Crafting Game with a Persona-Driven Character Based on Generative AI'
              data-cn="「我喜欢你的故事！」：基于生成式 AI 的角色驱动共创叙事游戏">
            "I Like Your Story!": A Co-Creative Story-Crafting Game with a Persona-Driven Character Based on Generative AI
          </h3>
          <p class="pub-venue">CHI EA '25 (Extended Abstracts)</p>
          <p class="pub-authors">Jiaying Fu, Xiruo Wang, Kate Vi, Zhouyi Li, <strong>Chuyan Xu</strong>, Yuqian Sun</p>
          <div class="pub-contribution">
            <strong data-en="Technical Contribution:" data-cn="技术贡献：">Technical Contribution:</strong>
            <span data-en="Engineered the persona-driven NPC logic and the co-creative narrative mechanics described in the research."
                  data-cn="设计并实现研究中描述的角色驱动 NPC 逻辑和共创叙事机制。">
              Engineered the persona-driven NPC logic and the co-creative narrative mechanics described in the research.
            </span>
          </div>
          <a href="https://doi.org/10.1145/3706599.3721163" class="pub-link" target="_blank" rel="noopener">
            <span>doi.org/10.1145/3706599.3721163</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Exhibitions Section -->
  <section class="exhibitions-section">
    <div class="container">
      <h2 class="section-title reveal" data-en="Exhibitions & Showcases" data-cn="展览与展映">Exhibitions & Showcases</h2>
      <p class="section-intro reveal" 
         data-en="Selected showcases of projects contributed as a Technical Lead or Core Developer:"
         data-cn="作为技术负责人或核心开发成员参与展示的精选展览：">
        Selected showcases of projects contributed as a Technical Lead or Core Developer:
      </p>

      <div class="exhibitions-grid">
        <div class="exhibition-card reveal">
          <div class="exhibition-year">2023</div>
          <h3>SIGGRAPH Asia 2023 Art Gallery</h3>
          <p class="exhibition-location">Sydney</p>
          <p class="exhibition-project" data-en="AI Nüshu (Technical Lead)" data-cn="AI 女书 (技术负责人)">AI Nüshu (Technical Lead)</p>
        </div>

        <div class="exhibition-card reveal">
          <div class="exhibition-year">2023</div>
          <h3>SIGGRAPH 2023 Art Gallery</h3>
          <p class="exhibition-location">Los Angeles</p>
          <p class="exhibition-project" data-en="Hyborg Agency (Core Developer)" data-cn="Hyborg Agency (核心开发)">Hyborg Agency (Core Developer)</p>
        </div>

        <div class="exhibition-card reveal">
          <div class="exhibition-year">2023</div>
          <h3>Gamescom 2023</h3>
          <p class="exhibition-location" data-en="Cologne" data-cn="科隆">Cologne</p>
          <p class="exhibition-project" data-en="1001 Nights (Lead Programmer)" data-cn="一千零一夜 (主程序)">1001 Nights (Lead Programmer)</p>
        </div>

        <div class="exhibition-card reveal">
          <div class="exhibition-year">2021</div>
          <h3 data-en="Beijing Contemporary Art Expo" data-cn="北京当代艺术博览会">Beijing Contemporary Art Expo</h3>
          <p class="exhibition-location" data-en="Beijing" data-cn="北京">Beijing</p>
          <p class="exhibition-project" data-en="Humans, Space, Time, and People" data-cn="人间、空间、时间和人">Humans, Space, Time, and People</p>
        </div>

        <div class="exhibition-card reveal">
          <div class="exhibition-year">2021</div>
          <h3>Infocomm China 2021</h3>
          <p class="exhibition-location" data-en="Beijing" data-cn="北京">Beijing</p>
          <p class="exhibition-project" data-en="Interactive Visual Systems" data-cn="实时交互视觉系统">Interactive Visual Systems</p>
        </div>

        <div class="exhibition-card reveal">
          <div class="exhibition-year">2019</div>
          <h3 data-en="Asia Digital Art Exhibition" data-cn="亚洲数字艺术展">Asia Digital Art Exhibition</h3>
          <p class="exhibition-location" data-en="Beijing" data-cn="北京">Beijing</p>
          <p class="exhibition-project" data-en="JD AI-Generated Map" data-cn="京东 AI 生成地图">JD AI-Generated Map</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Teaching Section -->
  <section class="teaching-section">
    <div class="container">
      <h2 class="section-title reveal" data-en="Teaching Experience" data-cn="教学经历">Teaching Experience</h2>
      
      <div class="teaching-list">
        <div class="teaching-item reveal">
          <span class="teaching-year">2025</span>
          <div class="teaching-content">
            <h3 data-en="Dify + Arduino Workshop" data-cn="Dify + Arduino 工作坊">Dify + Arduino Workshop</h3>
            <p data-en="Agentland Lab, Tsinghua Shenzhen International Graduate School" 
               data-cn="清华大学深圳国际研究生院 Agentland Lab">
              Agentland Lab, Tsinghua Shenzhen International Graduate School
            </p>
          </div>
        </div>

        <div class="teaching-item reveal">
          <span class="teaching-year">2023</span>
          <div class="teaching-content">
            <h3 data-en="Guest Lecture" data-cn="嘉宾讲座">Guest Lecture</h3>
            <p data-en="Department of Digital Media Art, Communication University of China"
               data-cn="中国传媒大学数字媒体艺术系">
              Department of Digital Media Art, Communication University of China
            </p>
          </div>
        </div>

        <div class="teaching-item reveal">
          <span class="teaching-year">2022</span>
          <div class="teaching-content">
            <h3 data-en="Guest Lecture" data-cn="嘉宾讲座">Guest Lecture</h3>
            <p data-en="Department of Information Art & Design, Tsinghua University"
               data-cn="清华大学信息艺术设计系">
              Department of Information Art & Design, Tsinghua University
            </p>
          </div>
        </div>

        <div class="teaching-item reveal">
          <span class="teaching-year">2019</span>
          <div class="teaching-content">
            <h3 data-en="Guest Lecture" data-cn="嘉宾讲座">Guest Lecture</h3>
            <p data-en="Department of Digital Media Art, Communication University of China"
               data-cn="中国传媒大学数字媒体艺术系">
              Department of Digital Media Art, Communication University of China
            </p>
          </div>
        </div>

        <div class="teaching-item reveal">
          <span class="teaching-year">2018</span>
          <div class="teaching-content">
            <h3 data-en="Processing and Scratch Workshop" data-cn="Processing 和 Scratch 工作坊">Processing and Scratch Workshop</h3>
            <p data-en="Yidiandian Children Education" data-cn="一点点儿童教育">Yidiandian Children Education</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    padding: 8rem 2rem 4rem;
    background: #000000;
    text-align: center;
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
  }

  .page-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-secondary);
    max-width: 700px;
    margin: 0 auto;
  }

  /* Publications Section */
  .publications-section {
    padding: 4rem 2rem;
    background: var(--color-bg-primary);
  }

  .intro-text {
    max-width: 900px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .intro-text p {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .publications-list {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .publication-card {
    background: var(--color-bg-secondary);
    padding: 2rem;
    border-radius: 1rem;
    box-shadow: var(--shadow-md);
    border-left: 4px solid var(--color-primary);
    transition: var(--transition);
    position: relative;
  }

  .publication-card:hover {
    box-shadow: var(--shadow-xl);
    transform: translateX(0.5rem);
  }

  .pub-badge {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    background: rgba(96, 165, 250, 0.15);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 0.375rem;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .pub-badge.award {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: #000000;
  }

  .pub-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .pub-venue {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .pub-authors {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .pub-contribution {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    padding: 1rem;
    background: var(--color-bg-secondary);
    border-radius: 0.5rem;
    margin: 1rem 0;
  }

  .pub-contribution strong {
    color: var(--color-text-primary);
  }

  .pub-award {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0.75rem 0;
  }

  .pub-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-family: inherit;
    color: var(--color-primary);
    margin-top: 0.75rem;
    transition: var(--transition);
  }

  .pub-link:hover {
    color: var(--color-primary-hover);
    text-decoration: underline;
  }

  /* Exhibitions Section */
  .exhibitions-section {
    padding: 4rem 2rem;
    background: var(--color-bg-secondary);
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 1rem;
    text-align: center;
    position: relative;
    display: inline-block;
    left: 50%;
    transform: translateX(-50%);
  }

  .section-title::after {
    content: '';
    position: absolute;
    bottom: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 4px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    border-radius: 2px;
  }

  .section-intro {
    max-width: 800px;
    margin: 2rem auto 3rem;
    text-align: center;
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  .exhibitions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .exhibition-card {
    background: var(--color-bg-secondary);
    padding: 1.5rem;
    border-radius: 1rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    border: 1px solid var(--color-border);
  }

  .exhibition-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
    border-color: var(--color-primary);
  }

  .exhibition-year {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(96, 165, 250, 0.15);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 0.375rem;
    margin-bottom: 0.75rem;
  }

  .exhibition-card h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .exhibition-location {
    font-size: 0.875rem;
    color: var(--color-text-light);
    margin-bottom: 0.5rem;
  }

  .exhibition-project {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
  }

  /* Teaching Section */
  .teaching-section {
    padding: 4rem 2rem;
    background: var(--color-bg-primary);
  }

  .teaching-list {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .teaching-item {
    display: flex;
    gap: 2rem;
    padding: 1.5rem;
    background: var(--color-bg-secondary);
    border-radius: 1rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    align-items: flex-start;
  }

  .teaching-item:hover {
    box-shadow: var(--shadow-md);
    transform: translateX(0.5rem);
  }

  .teaching-year {
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-primary);
    min-width: 60px;
  }

  .teaching-content h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 0.375rem;
  }

  .teaching-content p {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .page-header {
      padding: 6rem 1.25rem 3rem;
    }

    .publications-section,
    .exhibitions-section,
    .teaching-section {
      padding: 3rem 1.25rem;
    }

    .publication-card {
      padding: 1.5rem;
    }

    .exhibitions-grid {
      grid-template-columns: 1fr;
    }

    .teaching-item {
      flex-direction: column;
      gap: 0.75rem;
    }

    .teaching-year {
      min-width: auto;
    }
  }
</style>

<style>
  /* Shared portfolio treatment: no gradients, cards, or separate type system. */
  .page-header {
    min-height: 355px;
    padding: 92px 0 16px;
    background: transparent;
    text-align: left;
  }

  .page-header .container,
  .publications-section .container,
  .exhibitions-section .container,
  .teaching-section .container {
    max-width: 760px;
    margin: 0 12px;
    padding: 0;
  }

  .page-title,
  .section-title {
    position: static;
    left: auto;
    display: block;
    margin: 0;
    transform: none;
    text-align: left;
    font-size: .72rem;
    font-weight: 600;
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-label);
  }

  .section-title::after { display: none; }

  .page-subtitle,
  .intro-text p,
  .section-intro,
  .pub-title,
  .pub-contribution,
  .exhibition-project,
  .teaching-content p {
    color: #101010;
    font-size: clamp(1.05rem, 1.38vw, 1.38rem);
    font-weight: 500;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .page-subtitle { max-width: 34ch; margin: 14px 0 0; }

  .publications-section,
  .exhibitions-section,
  .teaching-section {
    padding: 0 0 78px;
    background: transparent;
  }

  .intro-text { max-width: 34ch; margin: 0 0 46px; text-align: left; }
  .publications-list { max-width: 680px; margin: 0; gap: 0; }

  .publication-card {
    position: static;
    margin: 0 0 46px;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .publication-card:hover,
  .exhibition-card:hover,
  .teaching-item:hover { transform: none; box-shadow: none; }

  .pub-badge,
  .exhibition-year {
    display: inline-block;
    margin: 0 0 10px;
    padding: 4px 8px;
    border: 1px solid #101010;
    border-radius: 0;
    background: transparent;
    color: #101010;
    font-size: .7rem;
    font-weight: 500;
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-label);
    text-transform: none;
  }

  .pub-badge.award { background: transparent; color: #101010; }
  .pub-title { margin: 0 0 10px; }
  .pub-venue,
  .pub-authors,
  .pub-award,
  .exhibition-location {
    margin: 0 0 7px;
    color: #666;
    font-size: .78rem;
    font-weight: 400;
    line-height: var(--leading-label);
    letter-spacing: var(--tracking-label);
  }

  .pub-contribution { margin: 16px 0; padding: 0; background: transparent; border-radius: 0; }
  .pub-contribution strong { font-weight: 500; }
  .pub-link { margin: 0; color: #101010; font-size: .78rem; line-height: var(--leading-label); letter-spacing: var(--tracking-label); }
  .pub-link svg { width: 12px; height: 12px; }

  .exhibitions-section .section-intro { max-width: 34ch; margin: 14px 0 38px; text-align: left; }
  .exhibitions-grid { max-width: none; margin: 0; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; }
  .exhibition-card { min-height: 180px; padding: 14px; background: #f4f4f4; border: 0; border-radius: 0; box-shadow: none; }
  .exhibition-card h3 { margin: 0 0 8px; color: #101010; font-size: .9rem; font-weight: 500; line-height: var(--leading-display); letter-spacing: var(--tracking-display); }
  .exhibition-project { margin: 12px 0 0; font-size: .9rem; }

  .teaching-section .section-title { margin-bottom: 38px; }
