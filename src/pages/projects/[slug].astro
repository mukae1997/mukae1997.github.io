---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { loadAllProjects, getProjectPublications } from '../../lib/csv';
import { getProjectMedia } from '../../lib/media';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({ params: { slug: entry.slug } }));
}

const { slug } = Astro.params;

// Load from content collection (the rich markdown content)
const projectEntry = slug ? await getEntry('projects', slug) : undefined;

// 404 if no MD entry exists for this slug
if (!projectEntry) {
  return Astro.redirect('/projects');
}

const { Content } = await projectEntry.render();
const mdData = projectEntry.data;

// Load CSV metadata for structured fields
const allProjects = loadAllProjects();
const csvProject = slug ? allProjects[slug] : null;

// Build media gallery from the project's image folder
const mediaGallery = getProjectMedia(slug!, mdData.cover || csvProject?.cover, { mode: 'natural', max: 999, excludeCover: true });

// Technologies: MD frontmatter is authoritative, CSV as fallback
const allTechnologies = mdData.technologies.length > 0
  ? mdData.technologies
  : csvProject
    ? [
        ...(csvProject.coreEngine ? csvProject.coreEngine.split(',').map((s) => s.trim()) : []),
        ...(csvProject.programmingLanguages ? csvProject.programmingLanguages.split(',').map((s) => s.trim()) : []),
        ...(csvProject.technologies ? csvProject.technologies.split('|').map((s) => s.trim()) : []),
      ].filter(Boolean)
    : [];

// Publications
const projectPublications = csvProject ? getProjectPublications(csvProject) : [];

// Display values — MD frontmatter takes precedence, CSV as fallback
const displayTitle = mdData.title || csvProject?.projectNameEN || '';
const displayTitleCN = mdData.titleCN || csvProject?.projectName || '';
const displayRole = mdData.role || csvProject?.role || '';
const displayRoleCN = mdData.roleCN || csvProject?.roleCN || '';

// Tags: MD frontmatter is authoritative, CSV as fallback
const tagSet = new Set<string>();
const addTag = (t: string) => { if (t) tagSet.add(t); };

const hasMdTags = mdData.category || mdData.projectType;
if (hasMdTags) {
  if (mdData.category) addTag(mdData.category);
  if (mdData.domain) mdData.domain.split(',').map((s) => s.trim()).filter(Boolean).forEach(addTag);
  if (mdData.projectType) addTag(mdData.projectType);
} else if (csvProject) {
  if (csvProject.category) addTag(csvProject.category);
  if (csvProject.domain) csvProject.domain.split(',').map((s) => s.trim()).filter(Boolean).forEach(addTag);
  if (csvProject.projectType) addTag(csvProject.projectType);
}

const tags = [...tagSet];

// Cover URL
const coverFilename = mdData.cover || csvProject?.cover || 'cover.png';
const coverUrl = `/images/projects/${slug}/${encodeURIComponent(coverFilename)}?v=20260726-3`;
---

<BaseLayout title={`${displayTitle} | XU CHUYAN`}>
  <div class="container">

    <!-- Project Hero -->
    <section class="project-hero">
      <h1 class="display-text project-title" data-en={displayTitle} data-cn={displayTitleCN || displayTitle}>
        {displayTitle}
      </h1>
      {mdData.tagline && (
        <p class="project-tagline data-text">{mdData.tagline}</p>
      )}
      {mdData.year && (
        <span class="project-year-label data-text">{mdData.year}{displayRole ? ` — ${displayRole}` : ''}</span>
      )}
    </section>

    <!-- Cover Image -->
    <section class="project-cover">
      <img src={coverUrl} alt={displayTitle} />
    </section>

    <!-- Tags -->
    {tags.length > 0 && (
      <section class="tags-section data-text">
        <div class="tags-row">
          {tags.map((tag) => (
            <span class="project-tag">{tag}</span>
          ))}
        </div>
      </section>
    )}

    <!-- Markdown Body -->
    <section class="project-section">
      <div class="project-body">
        <Content />
      </div>
    </section>

    <!-- Media Gallery -->
    {mediaGallery.length > 0 && (
      <section class="project-section">
        <div class="section-header data-text">
          <span data-en="Gallery" data-cn="媒体库">Gallery</span>
          <span>{mediaGallery.length} items</span>
        </div>
        <div class="media-gallery">
          {mediaGallery.map((media) => (
            <figure class={`media-item shape-${media.shape}`} style={`--media-ratio: ${media.ratio}`}>
              {media.type === 'video' ? (
                <video autoplay muted loop playsinline preload="metadata">
                  <source src={media.src} />
                </video>
              ) : (
                <img src={media.src} alt="" loading="lazy" />
              )}
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Technologies -->
    {allTechnologies.length > 0 && (
      <section class="project-section">
        <div class="section-header data-text">
          <span data-en="Technologies used" data-cn="使用技术">Technologies used</span>
          <span>{allTechnologies.length} tools</span>
        </div>
        <div class="tech-tags-row">
          {allTechnologies.map((tech) => (
            <span class="tech-tag">{tech}</span>
          ))}
        </div>
      </section>
    )}

    <!-- Exhibition -->
    {(mdData.exhibition || csvProject?.exhibition) && (
      <section class="project-section">
        <div class="section-header data-text">
          <span data-en="Exhibition" data-cn="展览">Exhibition</span>
        </div>
        <p class="overview-text">{mdData.exhibition || csvProject?.exhibition}</p>
      </section>
    )}

    <!-- Demo / Online Link -->
    {mdData.demoUrl && (
      <section class="project-section">
        <div class="section-header data-text">
          <span data-en="Online" data-cn="在线地址">Online</span>
        </div>
        <a href={mdData.demoUrl} target="_blank" rel="noopener noreferrer" class="demo-link data-text">
          {mdData.demoUrl}
        </a>
      </section>
    )}

    <!-- Awards -->
    {mdData.awards && (
      <section class="project-section">
        <div class="section-header data-text">
          <span data-en="Awards" data-cn="获奖">Awards</span>
        </div>
        <p class="overview-text">{mdData.awards}</p>
      </section>
    )}

    <!-- Publication -->
    {projectPublications.length > 0 && (
      <section class="project-section">
        <div class="section-header data-text">
          <span data-en="Publication" data-cn="发表">Publication</span>
        </div>
        <div class="publications-list">
          {projectPublications.map((pub) => (
            <div class="publication-row data-text">
              <span class="pub-year">{pub.year}</span>
              <span class="pub-title">
                {pub.url ? (
                  <a href={pub.url} target="_blank" rel="noopener noreferrer">{pub.title}</a>
                ) : (
                  pub.title
                )}
              </span>
              <span class="pub-venue">{pub.venue}</span>
            </div>
          ))}
        </div>
      </section>
    )}

  </div>
</BaseLayout>

<style>
  .data-text {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
    line-height: 1.4;
  }

  .display-text {
    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.85;
    text-transform: uppercase;
    margin: 0;
  }

  .container {
    width: 100%;
    padding: 0 24px;
    max-width: 1800px;
    margin: 0 auto;
  }

  /* Project Hero */
  .project-hero {
    padding: 66px 0 18px;
    background: transparent;
    border: 0;
  }

  .project-tagline {
    margin-top: 8px;
    color: var(--muted);
    text-transform: none;
    font-size: 0.85rem;
  }

  .project-year-label {
    display: inline-block;
    margin-top: 6px;
    color: var(--muted);
    text-transform: none;
  }

  /* Cover Image */
  .project-cover {
    margin: 24px 0 48px;
  }

  .project-cover img {
    width: 100%;
    display: block;
  }

  /* Tags Section */
  .tags-section {
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .tags-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .project-tag {
    padding: 6px 12px;
    background: var(--ink);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Project Sections */
  .project-section {
    padding: 40px 0;
    border-bottom: 1px solid var(--line);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .overview-text {
    font-size: 1.125rem;
    line-height: 1.8;
    max-width: 900px;
  }

  /* Markdown Body */
  .project-body {
    max-width: 62ch;
    font-size: clamp(1rem, 1.1vw, 1.1rem);
    line-height: 1.65;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .project-body :global(h2) {
    margin: 48px 0 12px;
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .project-body :global(h3) {
    margin: 32px 0 8px;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .project-body :global(p) {
    margin: 0 0 18px;
  }

  .project-body :global(img) {
    width: 100%;
    display: block;
    margin: 32px 0;
  }

  .project-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project-body :global(ul),
  .project-body :global(ol) {
    margin: 0 0 18px 20px;
    line-height: 1.65;
  }

  .project-body :global(li) {
    margin-bottom: 6px;
  }

  .project-body :global(blockquote) {
    margin: 24px 0;
    padding-left: 16px;
    border-left: 2px solid var(--ink);
    opacity: 0.8;
  }

  /* Media Gallery — 2 columns, natural ratio */
  .media-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .media-gallery:has(.media-item:only-child) {
    grid-template-columns: 1fr;
  }

  .media-item {
    margin: 0;
    background: #efefed;
  }

  .media-item img,
  .media-item video {
    width: 100%;
    max-height: 300px;
    object-fit: contain;
    display: block;
  }

  /* Publications */
  .publications-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .publication-row {
    display: grid;
    grid-template-columns: 80px 1fr 200px;
    gap: 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .pub-year {
    opacity: 0.5;
  }

  .pub-title {
    font-weight: 500;
  }

  .pub-title a {
    color: var(--ink);
    text-decoration: underline;
  }

  .pub-venue {
    opacity: 0.6;
    font-style: italic;
    text-align: right;
  }

  .demo-link {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-transform: none;
    font-size: 0.85rem;
  }

  /* Tech Tags */
  .tech-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-tag {
    padding: 6px 12px;
    border: 1px solid var(--ink);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.2s ease;
  }

  .tech-tag:hover {
    background: var(--ink);
    color: white;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .publication-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .pub-venue {
      text-align: left;
    }
  }

  @media (max-width: 768px) {
    .display-text {
      font-size: 14vw;
    }

    .project-hero {
      padding: 40px 0 12px;
    }

    .project-section {
      padding: 30px 0;
    }

    .project-cover {
      margin: 16px 0 32px;
    }

    .media-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
