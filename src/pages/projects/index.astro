---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { getDisplayedProjects } from '../../lib/csv';
import { getCollection } from 'astro:content';

const allProjects = getDisplayedProjects();

const sortedProjects = allProjects.sort((a, b) => {
  const yearA = parseInt(a.year) || 0;
  const yearB = parseInt(b.year) || 0;
  return yearB - yearA;
});

// Projects that have a content collection entry (rich detail pages)
const projectEntries = await getCollection('projects');
const mdSlugs = new Set(projectEntries.map((entry) => entry.slug));
const mdCoverMap = Object.fromEntries(
  projectEntries.map((e) => [e.slug, e.data.cover]),
);

const englishProjectNames: Record<string, string> = {
  'vj-project': 'The Either Tour — End Poem VJ',
  'vr-diving': 'Deep Sea Wonder (VR Immersive Experience)',
  'tianmu-dream': 'A Dream of Mount Tianmu',
  'ai-map': 'Artificial Intelligence Map',
  'mother-gyro': 'Mother Gyro',
  'swords-west-river': 'West River Sword Dance',
  'quancheng-memory': 'Memory of Quancheng',
  'music-realm': 'Music Realm',
  'parallel': 'Parallel',
  'humans-space-time': 'Humans, Space, Time, and People',
  'dance-shadows': 'Dance Shadows',
  'autumn-wind-nanyuan': 'Autumn Wind in Nanyuan',
  'journey-immortals': 'Journey to Immortals',
  '1001-nights': '1001 Nights',
  'dayin-heming': 'Dayin Heming',
};

const projectFeaturing: Record<string, string> = {
  '1001-nights': 'AI-native narrative game with an LLM content pipeline',
  'echuu': 'Turn 3D avatars into livestream-ready AI VTubers',
  'xixi': 'AI companion campaign with a voice-to-character flow',
  'dayin-heming': 'Immersive music-themed exhibition with AI-produced interactive installations',
  'hyborg-agency': 'Multi-agent public experience for collective worldbuilding',
  'ai-nushu': 'Interactive AI revival of Nüshu',
  'ai-map': 'Interactive AI knowledge visualization',
  'vr-diving': 'Immersive spatial interaction environment',
  'vj-project': 'Touring live visuals powered by a real-time generative engine',
  'journey-immortals': 'Location-based interaction environment',
  'parallel': 'Audiovisual worldbuilding performance',
  'humans-space-time': 'Interactive digital installation at Beijing Contemporary Art Expo',
  'dance-shadows': 'Interactive performance at Infocomm 2021 with BlackTrax motion capture',
  'autumn-wind-nanyuan': 'Multimedia interactive dance drama for China National Song and Dance Theater',
  'quancheng-memory': 'Interactive city-memory experience',
  'music-realm': 'Immersive musical interaction world',
  'mother-gyro': 'Kinetic sculpture interaction system',
  'swords-west-river': 'Real-time interactive performance at the National Grand Theatre',
  'tianmu-dream': 'Generative mythic landscape experience',
};

const portfolioGroups = [
  { value: 'Game', label: 'Game' },
  { value: 'AIGC', label: 'AIGC' },
  { value: 'Exhibitions · Art & Performances', label: 'Exhibitions, Art & Performances' },
];

// Portfolio Category is maintained in Notion and synchronized into this CSV.
const projectGroups = portfolioGroups.map(({ value, label }) => ({
  value,
  label,
  projects: sortedProjects.filter((project) => project.portfolioCategory === value),
})).filter((group) => group.projects.length > 0);

---

<BaseLayout title="Projects | XU CHUYAN">
  <div class="mesh-background"></div>

  <div class="container">

    <!-- Page Title -->
    <section class="page-hero projects-hero">
      <h1 class="display-text page-title" data-en="Projects" data-cn="项目作品">Projects</h1>
    </section>

    <!-- Projects List -->
    <section class="projects-list-section">
      {projectGroups.map(({ value, label, projects }) => (
        <section class="project-group" aria-labelledby={`group-${value.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`}>
          <div class="project-group-heading">
            <h2 id={`group-${value.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`} class="project-group-title">{label}</h2>
            <span class="project-group-feature-label" aria-hidden="true">Featuring</span>
          </div>
          <div class="projects-list">
        {projects.map((project, index) => {
          const year = project.year;
          const name = project.projectName;
          const slug = project.slug;
          const nameEn = project.projectNameEN || englishProjectNames[slug] || name;
          const featuring = projectFeaturing[slug] || 'Interactive experience';
          const domains = project.domain?.split(',').map((item) => item.trim()).filter(Boolean) || [];
          const domainText = domains.join(' / ');
          const hasDetailPage = mdSlugs.has(slug);
          const cover = mdCoverMap[slug] || project.cover || 'cover.png';
          const coverPath = `/images/projects/${slug}/${encodeURIComponent(cover)}`;
          const coverUrl = `${coverPath}?v=20260726-3`;
          const hasCover = existsSync(resolve('./public', coverPath.slice(1)));

          const rowContent = (
            <>
              <span class="project-num">{(index + 1).toString().padStart(2, '0')}</span>
              <div class="project-image-inline">
                {hasCover ? (
                  <img src={coverUrl} alt={name} />
                ) : (
                  <span class="project-image-placeholder">{nameEn}</span>
                )}
              </div>
              <span class="project-name">
                <span class="project-name-en">{nameEn}</span>
                {name && name !== nameEn && <span class="project-name-cn">{name}</span>}
                {domainText && <span class="project-name-domain">{domainText}</span>}
              </span>
              <span class="project-featuring">{featuring}</span>
              <span class="project-year">({year})</span>
            </>
          );

          return hasDetailPage ? (
            <a href={`/projects/${slug}`} class="project-row data-text">
              {rowContent}
            </a>
          ) : (
            <div class="project-row project-row-disabled data-text">
              {rowContent}
            </div>
          );
        })}
          </div>
        </section>
      ))}
    </section>

    <!-- Floating Text Zone -->
    <section class="distortion-zone">
      <div class="floating-text" style="transform: rotate(15deg) translate(-20%, -20%); top: 20%; left: 10%;" data-en="CREATE" data-cn="创造">CREATE</div>
      <div class="floating-text" style="transform: rotate(-10deg); top: 50%; right: 10%; font-size: 8rem;" data-en="BUILD" data-cn="构建">BUILD</div>
      <div class="floating-text" style="transform: rotate(90deg); left: 5%; bottom: 10%; font-size: 4rem;" data-en="DESIGN" data-cn="设计">DESIGN</div>
      <div class="floating-text" style="transform: rotate(-5deg); bottom: 10%; right: 20%;" data-en="EXPERIMENT" data-cn="实验">EXPERIMENT</div>
    </section>

  </div>

  <!-- Sticker Badge -->
  <div class="sticker-badge">
    <div class="sticker-icon">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="2" y1="12" x2="22" y2="12"></line>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
      </svg>
    </div>
    <div class="sticker-text">
      XU CHUYAN STUDIO<br>
      PROJECTS PORTFOLIO<br>
      SECURE CONNECTION
    </div>
  </div>
</BaseLayout>

<style>
  :root {
    --black: #050505;
    --bg-mesh-1: #c4b5fd;
    --bg-mesh-2: #99f6e4;
    --bg-mesh-3: #fef3c7;
    --bg-mesh-4: #fecaca;
  }

  .mesh-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    background:
      radial-gradient(at 0% 0%, var(--bg-mesh-1) 0px, transparent 50%),
      radial-gradient(at 100% 0%, var(--bg-mesh-2) 0px, transparent 50%),
      radial-gradient(at 100% 100%, var(--bg-mesh-4) 0px, transparent 50%),
      radial-gradient(at 0% 100%, var(--bg-mesh-3) 0px, transparent 50%),
      radial-gradient(at 50% 50%, #fff 0px, transparent 50%);
    background-size: 150% 150%;
    filter: blur(80px);
    animation: gradient-shift 20s ease infinite alternate;
    opacity: 0.9;
  }

  @keyframes gradient-shift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 50% 100%; }
  }

  .data-text {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
    line-height: 1.4;
  }

  .display-text {
    font-size: clamp(4rem, 15vw, 12rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 0.85;
    text-transform: uppercase;
    margin: 0;
  }

  .container {
    width: 100%;
    padding: 0 24px;
    max-width: 1800px;
    margin: 0 auto;
  }

  /* Projects Header */
  .projects-header {
    padding-top: 80px;
  }

  .manifest-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    padding: 12px 0;
    border-bottom: 1px solid var(--black);
  }

  .manifest-row.top-border {
    border-top: 1px solid var(--black);
  }

  .manifest-item {
    display: flex;
    flex-direction: column;
  }

  .manifest-label {
    opacity: 0.5;
    margin-bottom: 4px;
  }

  .back-link {
    color: var(--black);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .back-link:hover {
    opacity: 0.5;
  }

  /* Page Hero */
  .page-hero {
    padding: 60px 0;
    border-bottom: 1px solid var(--black);
  }

  /* Projects List */
  .projects-list-section {
    padding: 40px 0;
    border-bottom: 1px solid rgba(5, 5, 5, 0.2);
  }

  .projects-list {
    display: flex;
    flex-direction: column;
  }

  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: 50px 0fr 2fr 1.5fr 100px;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid rgba(5, 5, 5, 0.15);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    color: var(--black);
    align-items: center;
    background: rgba(255, 255, 255, 0.5);
    overflow: hidden;
  }

  .project-row:hover {
    padding: 20px 16px;
    background: rgba(255, 255, 255, 0.95);
    border-bottom: 1px solid var(--black);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    grid-template-columns: 50px 180px 2fr 1.5fr 100px;
  }

  /* Disabled state — hover preview works, just no link */
  .project-row-disabled {
    opacity: 0.6;
  }

  .project-image-inline {
    overflow: hidden;
    opacity: 0;
    transform: translateX(-20px);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .project-image-inline img {
    width: 180px;
    height: 100px;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }

  .project-row:hover .project-image-inline {
    opacity: 1;
    transform: translateX(0);
  }

  /* Disabled image placeholder */
  .project-image-disabled {
    background: rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .no-image-placeholder {
    font-family: inherit;
    font-size: 0.7rem;
    opacity: 0.5;
    text-transform: uppercase;
  }

  .project-num {
    opacity: 0.5;
    font-weight: 600;
    font-size: 0.875rem;
  }

  .project-name {
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .project-name-cn {
    opacity: 0.6;
    font-size: 0.8rem;
    font-weight: 400;
    text-transform: none;
  }

  .project-tech {
    opacity: 0.7;
    font-size: 0.7rem;
  }

  .project-year {
    text-align: right;
    opacity: 0.5;
    font-size: 0.875rem;
  }

  /* Distortion Zone */
  .distortion-zone {
    position: relative;
    height: 50vh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid var(--black);
  }

  .floating-text {
    position: absolute;
    font-size: 6rem;
    text-transform: uppercase;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    will-change: transform;
    opacity: 0.15;
    letter-spacing: 0.1em;
  }

  /* Sticker Badge */
  .sticker-badge {
    position: fixed;
    bottom: 30px;
    right: 30px;
    background: var(--black);
    color: white;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 100;
    transform: rotate(-2deg);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
  }

  .sticker-badge:hover {
    transform: rotate(0deg) scale(1.05);
  }

  .sticker-icon {
    width: 24px;
    height: 24px;
    border: 1px solid white;
    border-radius: 50%;
    display: grid;
    place-items: center;
  }

  .sticker-text {
    font-family: inherit;
    font-size: 0.65rem;
    line-height: 1.3;
    text-align: left;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .project-row,
    .project-row:hover {
      grid-template-columns: 50px 1fr;
      gap: 8px;
    }

    .project-image-inline {
      display: none;
    }

    .project-tech,
    .project-year {
      grid-column: 2;
      font-size: 0.65rem;
    }

    .project-year {
      text-align: left;
    }
  }

  @media (max-width: 768px) {
    .display-text {
      font-size: 14vw;
    }

    .projects-header {
      padding-top: 60px;
    }

    .page-hero {
      padding: 40px 0;
    }

    .manifest-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .project-row {
      grid-template-columns: 40px 1fr;
      padding: 12px 0;
    }

    .project-num {
      font-size: 0.7rem;
    }

    .project-name {
      font-size: 0.85rem;
    }

    .project-name-cn {
      font-size: 0.75rem;
    }

    .floating-text {
      font-size: 3rem !important;
    }

    .sticker-badge {
      bottom: 20px;
      right: 20px;
    }
  }
  /* Keep the portfolio index text-led, with color carried by the surrounding UI. */
  :root {
    --black: #17152d;
    --bg-mesh-1: #9386ff;
    --bg-mesh-2: #73d9ff;
    --bg-mesh-3: #ffd18a;
    --bg-mesh-4: #ff9fc6;
    --electric: #6457f5;
  }

  .mesh-background {
    background-size: 175% 175%;
    filter: blur(58px) saturate(1.15);
    animation-duration: 18s;
    opacity: 0.78;
  }

  .project-row {
    border: 1px solid rgba(23, 21, 45, 0.1);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.58);
    backdrop-filter: blur(10px);
    margin-bottom: 8px;
    transition: all 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .project-row:hover {
    background: linear-gradient(105deg, rgba(255,255,255,.96), rgba(237,234,255,.9) 55%, rgba(210,245,255,.82));
    border-color: rgba(100, 87, 245, .42);
    box-shadow: 0 16px 34px rgba(65, 48, 158, 0.16);
  }

  .project-image-inline img { border-radius: 9px; }
  .project-name { font-size: .95rem; font-weight: 700; }

  .distortion-zone {
    border: 1px solid rgba(23, 21, 45, .18);
    border-radius: 24px;
    background: linear-gradient(125deg, rgba(100,87,245,.18), rgba(115,217,255,.2), rgba(255,159,198,.22));
  }

  .sticker-badge { background: linear-gradient(135deg, #312c70, #6a5cff 58%, #fd7298); }
</style>

<script>
  // Floating text parallax effect
  const floatingTexts = document.querySelectorAll('.floating-text');

  document.addEventListener('mousemove', (e) => {
    const x = e.clientX / window.innerWidth;
    const y = e.clientY / window.innerHeight;

    floatingTexts.forEach((text, index) => {
      const speed = (index + 1) * 15;
      const xOffset = (0.5 - x) * speed;
      const yOffset = (0.5 - y) * speed;

      const originalRotation = text.style.transform.match(/rotate\(([^)]+)\)/);
      const rot = originalRotation ? originalRotation[0] : 'rotate(0deg)';

      text.style.transform = `${rot} translate(${xOffset}px, ${yOffset}px)`;
    });
  });
</script>
