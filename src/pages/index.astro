---
import BaseLayout from '../layouts/BaseLayout.astro';
import { existsSync, readFileSync, readdirSync } from 'node:fs';
import { resolve } from 'node:path';

function parseCsv(csvText: string): Record<string, string>[] {
  const lines = csvText.trim().split('\n').filter(Boolean);
  const parseLine = (line: string) => {
    const values: string[] = [];
    let value = '';
    let inQuotes = false;

    for (const character of line) {
      if (character === '"') {
        inQuotes = !inQuotes;
      } else if (character === ',' && !inQuotes) {
        values.push(value.trim());
        value = '';
      } else {
        value += character;
      }
    }

    values.push(value.trim());
    return values;
  };

  const headers = parseLine(lines[0]);
  return lines.slice(1).map((line) => {
    const values = parseLine(line);
    return Object.fromEntries(headers.map((header, index) => [header, values[index] || '']));
  });
}

const projectData = parseCsv(readFileSync(resolve('./src/data/projects-master.csv'), 'utf-8'));
const publicationData = parseCsv(readFileSync(resolve('./src/data/publications.csv'), 'utf-8'));
const imageExtensions = new Set(['.png', '.jpg', '.jpeg', '.webp', '.gif']);
const videoExtensions = new Set(['.mp4', '.webm', '.mov', '.m4v']);

function getImageRatio(filePath: string) {
  const bytes = readFileSync(filePath);

  // PNG
  if (bytes.subarray(1, 4).toString() === 'PNG') {
    return bytes.readUInt32BE(16) / bytes.readUInt32BE(20);
  }

  // GIF
  if (bytes.subarray(0, 3).toString() === 'GIF') {
    return bytes.readUInt16LE(6) / bytes.readUInt16LE(8);
  }

  // JPEG
  if (bytes[0] === 0xff && bytes[1] === 0xd8) {
    let offset = 2;
    while (offset < bytes.length - 9) {
      if (bytes[offset] !== 0xff) {
        offset += 1;
        continue;
      }
      const marker = bytes[offset + 1];
      const length = bytes.readUInt16BE(offset + 2);
      if ([0xc0, 0xc1, 0xc2, 0xc3, 0xc5, 0xc6, 0xc7, 0xc9, 0xca, 0xcb, 0xcd, 0xce, 0xcf].includes(marker)) {
        return bytes.readUInt16BE(offset + 7) / bytes.readUInt16BE(offset + 5);
      }
      offset += 2 + length;
    }
  }

  // Unknown formats keep a neutral tile rather than failing the page build.
  return 1;
}

function getMediaShape(ratio: number) {
  if (ratio > 1.25) return 'wide';
  if (ratio < 0.8) return 'tall';
  return 'square';
}

function stableNumber(value: string) {
  return [...value].reduce((total, character) => ((total * 31) + character.charCodeAt(0)) >>> 0, 0);
}

function getProjectMedia(project: Record<string, string>) {
  const slug = project.slug;
  const folder = resolve('./public/images/projects', slug);
  const cover = project.Cover || 'cover.png';

  if (!slug || !existsSync(folder)) return [];

  const files = readdirSync(folder)
    .filter((file) => {
      const extension = file.slice(file.lastIndexOf('.')).toLowerCase();
      return imageExtensions.has(extension) || videoExtensions.has(extension);
    })
    .sort((a, b) => a.localeCompare(b));
  const orderedFiles = [cover, ...files.filter((file) => file !== cover)];

  const availableFiles = [...new Set(orderedFiles)]
    .filter((file) => existsSync(resolve(folder, file)))
    .slice(0, 4);
  if (availableFiles.length === 0) return [];

  const seed = stableNumber(slug);
  const squareIndexes = new Set([seed % availableFiles.length]);

  // Four-piece galleries get a second square tile; the choice stays stable per project.
  if (availableFiles.length >= 4) squareIndexes.add((seed + 2) % availableFiles.length);

  return availableFiles
    .map((file, index) => {
      const extension = file.slice(file.lastIndexOf('.')).toLowerCase();
      const isVideo = videoExtensions.has(extension);
      const sourceRatio = isVideo ? 16 / 9 : getImageRatio(resolve(folder, file));
      const ratio = squareIndexes.has(index) ? 1 : sourceRatio;
      return {
        type: isVideo ? 'video' : 'image',
        // Keep deployment updates from reusing a browser-cached missing asset.
        src: `/images/projects/${slug}/${encodeURIComponent(file)}?v=20260726-2`,
        ratio: Math.max(0.4, Math.min(2.5, ratio)).toFixed(3),
        shape: getMediaShape(ratio),
      };
    });
}

const featuredProjects = projectData
  .filter((project) => ['true', '1', 'TRUE'].includes(project.Display) && ['true', '1', 'TRUE'].includes(project.Featured))
  .map((project) => ({ ...project, media: getProjectMedia(project) }))
  .filter((project) => project.media.length > 0)
  .sort((a, b) => Number(b.year || 0) - Number(a.year || 0));

const publications = publicationData.slice(0, 3);
---

<BaseLayout title="XU CHUYAN | Creative Technologist" hideNav>
  <main class="home-page">
    <nav class="global-nav site-nav" aria-label="Primary navigation">
      <a class="global-wordmark wordmark" href="/">Xu Chuyan</a>
      <a class="global-context site-clock" href="/projects">Projects</a>
      <div class="global-links nav-links">
        <a href="/about">About</a>
      </div>
    </nav>

    <section class="intro" aria-labelledby="intro-title">
      <p class="eyebrow">CREATIVE TECHNOLOGIST · SHANGHAI, CHINA</p>
      <h1 id="intro-title">I build interactive experiences where technology becomes something you can feel.</h1>
      <p class="intro-note">Unity, real-time visuals, AI, sensors, games, and spatial installations.</p>
    </section>

    <section class="work-section" aria-labelledby="work-title">
      <div class="section-label">
        <h2 id="work-title">Selected work</h2>
        <span>2023—2018</span>
      </div>

      <div class="work-list">
        {featuredProjects.map((project, index) => {
          const name = project['Project Name EN'] || project['Project Name'];
          const category = project.Category || project['Project Type'] || 'Interactive Experience';
          const role = project.Role || 'Creative Technologist';

          return (
            <article class="project-feature">
              <div class="project-heading">
                <span class="project-index">{String(index + 1).padStart(2, '0')}</span>
                <h3>{name}</h3>
                <span class="project-heading-details">{project.category}, {project.year}</span>
                <span class="project-arrow" aria-hidden="true">+</span>
              </div>

              <div class="project-meta">
                <span>{project.year}</span>
                <span>{category}</span>
                <span>{role}</span>
              </div>

              <div class="project-gallery">
                {project.media.map((media, imageIndex) => (
                  <figure class={`project-media media-${imageIndex + 1} shape-${media.shape}`} style={`--media-ratio: ${media.ratio}`}>
                    {media.type === 'video' ? (
                      <video autoplay muted loop playsinline preload="metadata" aria-hidden="true">
                        <source src={media.src} />
                      </video>
                    ) : (
                      <img src={media.src} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
                    )}
                  </figure>
                ))}
              </div>
            </article>
          );
        })}
      </div>

      <a class="archive-link" href="/projects">View all projects <span>↗</span></a>
    </section>

    {publications.length > 0 && (
      <section class="publications" aria-labelledby="publication-title">
        <div class="section-label">
          <h2 id="publication-title">Research</h2>
          <a href="/research">View all ↗</a>
        </div>
        <div class="publication-list">
          {publications.map((publication) => (
            <a class="publication" href={publication.url} target="_blank" rel="noreferrer">
              <span>{publication.year}</span>
              <em class="publication-title">{publication.title}</em>
              <span>{publication.venue}</span>
            </a>
          ))}
        </div>
      </section>
    )}

  </main>
</BaseLayout>

<style>
  :global(body) {
    background: #fcfcfa;
    color: #101010;
  }

  :global(.lang-btn) {
    font-size: 0.65rem;
  }

  .home-page {
    max-width: 1680px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .site-nav,
  .section-label,
  .project-meta,
  .publication,
  .eyebrow,
  .intro-note {
    font-size: 0.68rem;
    line-height: 1.3;
    letter-spacing: var(--tracking-label);
    text-transform: none;
  }

  .site-nav {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #101010;
    padding-right: 112px;
  }

  .wordmark,
  .nav-links a,
  .archive-link,
  .publication {
    color: #101010;
    text-decoration: none;
  }

  .wordmark { font-weight: 700; }

  .nav-links { display: flex; gap: 20px; }
  .nav-links a:hover, .wordmark:hover { opacity: 0.45; }

  .intro {
    min-height: min(72vh, 760px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 30px 0 42px;
    border-bottom: 1px solid #101010;
  }

  .intro h1 {
    max-width: 18ch;
    margin: auto 0;
    font-family: inherit;
    color: #101010;
    font-size: clamp(3.2rem, 8.1vw, 8.8rem);
    font-weight: 400;
    letter-spacing: -0.075em;
    line-height: 0.87;
  }

  .intro-note { max-width: 48ch; }

  .work-section, .publications { padding: 22px 0 96px; }

  .section-label {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid #101010;
    padding-bottom: 8px;
  }

  .section-label h2 { font: inherit; }
  .section-label a { color: inherit; text-decoration: none; }

  .project-feature { padding: 12px 0 56px; }

  .project-heading {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: baseline;
    color: inherit;
    text-decoration: none;
    padding: 5px 0;
  }

  .project-heading h3 {
    font-family: inherit;
    color: inherit;
    font-size: clamp(1.9rem, 4.8vw, 5.2rem);
    font-weight: 400;
    letter-spacing: -0.07em;
    line-height: 0.9;
  }

  .project-index, .project-arrow { font-size: 0.7rem; }
  .project-arrow { opacity: 0; transform: translate(-8px, 8px); transition: .25s ease; }
  .project-heading:hover .project-arrow { opacity: 1; transform: translate(0, 0); }

  .project-meta {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr) minmax(120px, .45fr);
    gap: 12px;
    margin: 10px 0 18px;
    color: #616161;
  }

  .project-gallery {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 6px;
    color: inherit;
  }

  .project-media { overflow: hidden; background: #efefed; }
  .project-media img,
  .project-media video { width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.2,.8,.2,1); }
  .project-gallery:hover img,
  .project-gallery:hover video { transform: scale(1.035); }
  .media-1 { grid-column: span 7; height: min(48vw, 620px); }
  .media-2 { grid-column: span 5; height: calc(min(48vw, 620px) * .48); align-self: end; }
  .media-3 { grid-column: 8 / span 5; height: calc(min(48vw, 620px) * .48); }

  .archive-link {
    display: inline-flex;
    gap: 10px;
    border: 1px solid #101010;
    padding: 12px 15px;
    font-size: 0.7rem;
    letter-spacing: var(--tracking-label);
  }
  .archive-link:hover { background: #101010; color: #fff; }

  .publications { padding-top: 0; }
  .publication-list { display: flex; flex-direction: column; }
  .publication {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr) minmax(120px, .35fr);
    gap: 18px;
    padding: 14px 0;
    border-bottom: 1px solid #d2d2ce;
    text-transform: none;
  }
  .publication:hover { opacity: .5; }
  .publication-title { font-style: italic; }

  @media (max-width: 720px) {
    .home-page { padding: 0 14px; }
    .nav-links { gap: 10px; }
    .intro { min-height: 64vh; }
    .intro h1 { max-width: 13ch; font-size: clamp(3rem, 13vw, 5.5rem); }
    .project-feature { padding-bottom: 40px; }
    .project-heading { grid-template-columns: 30px minmax(0, 1fr) auto; }
    .project-meta { grid-template-columns: 30px minmax(0, 1fr); }
    .project-meta span:last-child { grid-column: 2; }
    .media-1 { grid-column: span 12; height: 82vw; }
    .media-2, .media-3 { grid-column: span 6; height: 42vw; }
    .publication { grid-template-columns: 1fr; gap: 7px; }
  }

  /* Nolan Barret-inspired full-page canvas layout */
  :global(body) {
    background: #101010;
    padding: 20px 24px !important;
  }

  .home-page {
    max-width: none;
    min-height: calc(100vh - 40px);
    padding: 0 12px;
    border-radius: 30px;
    overflow: clip;
    background: #fcfcfa;
  }

  .site-nav {
    min-height: 42px;
    padding: 0;
    border: 0;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    font-size: .7rem;
  }

  .site-clock {
    justify-self: center;
    font-size: .7rem;
    letter-spacing: 0;
  }

  .nav-links {
    grid-column: 3;
    justify-self: end;
    justify-content: flex-end;
    gap: clamp(18px, 2.4vw, 32px);
  }

  .site-nav,
  .site-nav .wordmark,
  .site-nav .nav-links a,
  .site-clock {
    text-transform: none;
    letter-spacing: 0;
  }

  .site-nav .wordmark,
  .site-nav .nav-links a { position: relative; }

  .site-nav .wordmark { font-weight: 650; }

  .site-nav .wordmark:hover,
  .site-nav .nav-links a:hover { opacity: 1; }

  .intro {
    min-height: 355px;
    padding: 92px 0 16px;
    border: 0;
    justify-content: flex-start;
  }

  .intro h1 {
    max-width: 34ch;
    margin: 0;
    font-size: clamp(1.05rem, 1.38vw, 1.38rem);
    font-weight: 500;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-display);
  }

  .eyebrow { display: none; }
  .intro-note { display: none; }

  .work-section {
    padding: 0 0 82px;
  }

  .section-label {
    display: none;
  }

  .project-feature {
    padding: 0 0 78px;
  }

  .project-heading {
    display: flex;
    gap: 5px;
    align-items: baseline;
    padding: 0 0 8px;
  }

  .project-heading h3 {
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: -.03em;
    line-height: 1;
  }

  .project-heading-details {
    color: #999;
    font-size: .7rem;
    letter-spacing: .01em;
  }

  .project-index { display: none; }
  .project-arrow { opacity: 1; transform: none; font-size: 1rem; font-weight: 300; }

  .project-meta {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .project-gallery {
    gap: 4px;
    align-items: stretch;
    grid-auto-flow: row;
  }

  /* Pack each project's media continuously; do not reserve empty grid columns. */
  .project-gallery:has(.project-media:only-child) { grid-template-columns: minmax(0, 1fr); }
  .project-gallery:has(.project-media:nth-child(2):last-child) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .project-gallery:has(.project-media:nth-child(3):last-child) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .project-gallery:has(.project-media:nth-child(4):last-child) { grid-template-columns: repeat(4, minmax(0, 1fr)); }

  .project-media,
  .media-1,
  .media-2,
  .media-3,
  .media-4 {
    grid-column: span 3;
    height: auto;
    aspect-ratio: var(--media-ratio, 1);
    align-self: start;
  }

  .project-gallery .project-media { grid-column: auto !important; }

  .project-media img,
  .project-media video { transition-duration: .45s; }
  .project-gallery:hover img,
  .project-gallery:hover video { transform: scale(1.015); }

  .project-media:only-child { grid-column: span 12; }
  .project-media:first-child:nth-last-child(2),
  .project-media:nth-child(2):last-child { grid-column: span 6; }
  .project-media:first-child:nth-last-child(3),
  .project-media:nth-child(2):nth-last-child(2),
  .project-media:nth-child(3):last-child { grid-column: span 4; }

  .archive-link {
    border: 0;
    padding: 0;
    font-size: .68rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .archive-link:hover { background: transparent; color: #101010; opacity: .5; }

  .publications {
    padding: 20px 0 82px;
    border-top: 1px solid #101010;
  }

  .publications .section-label { display: flex; }

  @media (max-width: 720px) {
    :global(body) { padding: 0 !important; }
    .home-page { min-height: 100vh; border-radius: 0; padding: 0 12px; }
    .site-nav { grid-template-columns: 1fr auto 1fr; padding-right: 0; }
    .nav-links > a { display: inline-block; }
    .nav-links { display: flex; }
    .intro { min-height: 260px; padding-top: 74px; }
    .intro h1 { font-size: 1.15rem; max-width: 26ch; }
    .project-feature { padding-bottom: 48px; }
    .project-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 3px; }
    .project-media,
    .media-1,
    .media-2,
    .media-3,
    .media-4 { grid-column: span 6; height: auto; aspect-ratio: var(--media-ratio, 1); }
    .project-media:only-child { grid-column: span 12; }
    .project-media:first-child:nth-last-child(3) { grid-column: span 12; height: auto; }
    .project-media:nth-child(2):nth-last-child(2),
    .project-media:nth-child(3):last-child { grid-column: span 6; height: auto; }
  }
</style>
